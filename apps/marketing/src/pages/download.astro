---
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import iconStable from "../assets/icon.webp";
import iconNightly from "../assets/icon-nightly.webp";
import Layout from "../layouts/Layout.astro";
import { NIGHTLY_RELEASES_URL, RELEASES_URL } from "../lib/releases";

const imageProps = {
  alt: "",
  densities: [1, 2, 3],
  format: "webp",
  quality: 90,
  decoding: "async",
} satisfies Partial<ComponentProps<typeof Image>>;
---

<Layout
  title="Get started with T3 Code"
  description="Open the hosted web app or install the T3 Code server and CLI."
>
  <div class="get-started" id="get-started" data-channel="stable">
    <header class="intro">
      <span class="brand-icon" aria-hidden="true">
        <Image class="stable-icon" src={iconStable} width={56} height={56} loading="eager" {...imageProps} />
        <Image class="nightly-icon" src={iconNightly} width={56} height={56} loading="eager" {...imageProps} />
      </span>
      <p class="eyebrow">Open source coding agents</p>
      <h1>Run T3 Code in your browser.</h1>
      <p class="lede">
        Open the hosted app, or install the CLI to run a T3 Code server on your own machine.
      </p>
      <a class="web-link" href="https://app.t3.codes">Open the web app</a>
    </header>

    <section class="install-card" aria-labelledby="install-title">
      <div class="card-heading">
        <div>
          <p class="eyebrow">Self-hosted</p>
          <h2 id="install-title">Install the server and CLI</h2>
        </div>
        <a class="release-link" id="release-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
          <span id="version-label">View releases</span>
          <span aria-hidden="true"> ↗</span>
        </a>
      </div>

      <div class="channel-toggle" role="tablist" aria-label="Release channel">
        <button type="button" role="tab" data-channel="stable" aria-selected="true">Stable</button>
        <button type="button" role="tab" data-channel="nightly" aria-selected="false">Nightly</button>
      </div>

      <div class="commands" aria-label="Installation commands">
        <div class="command-group">
          <h3>macOS, Linux</h3>
          <code class="stable-command">curl -fsSL https://t3.codes/install.sh | sh</code>
          <code class="nightly-command">curl -fsSL https://t3.codes/install.sh | T3CODE_CHANNEL=nightly sh</code>
        </div>
        <div class="command-group">
          <h3>Windows PowerShell</h3>
          <code class="stable-command">irm https://t3.codes/install.ps1 | iex</code>
          <code class="nightly-command">$env:T3CODE_CHANNEL="nightly"; irm https://t3.codes/install.ps1 | iex</code>
        </div>
      </div>

      <div class="try-once">
        <p>Or run it once without installing:</p>
        <code class="stable-command">npx t3@latest</code>
        <code class="nightly-command">npx t3@nightly</code>
      </div>
    </section>

    <p class="requirements">The CLI starts a local server and opens the web app in your browser.</p>
    <a class="source-link" href="https://github.com/pingdotgg/t3code">Browse the source on GitHub</a>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, NIGHTLY_RELEASES_URL, RELEASES_URL, type ReleaseChannel } from "../lib/releases";

  const page = document.getElementById("get-started")!;
  const versionLabel = document.getElementById("version-label")!;
  const releaseLink = document.getElementById("release-link") as HTMLAnchorElement;
  const tabs = page.querySelectorAll<HTMLButtonElement>(".channel-toggle button");

  function selectedChannel(): ReleaseChannel {
    return new URLSearchParams(location.search).get("channel") === "nightly" ? "nightly" : "stable";
  }

  async function load(channel: ReleaseChannel) {
    page.dataset.channel = channel;
    tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.channel === channel)));
    releaseLink.href = channel === "nightly" ? NIGHTLY_RELEASES_URL : RELEASES_URL;
    versionLabel.textContent = "View releases";

    try {
      const release = await fetchLatestRelease(channel);
      if (page.dataset.channel !== channel) return;
      versionLabel.textContent = channel === "nightly" ? `Nightly ${release.tag_name}` : release.tag_name;
      if (release.html_url) releaseLink.href = release.html_url;
    } catch {
      // The install commands still work when GitHub's release API is unavailable.
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const channel = tab.dataset.channel as ReleaseChannel;
      const url = new URL(location.href);
      if (channel === "nightly") url.searchParams.set("channel", "nightly");
      else url.searchParams.delete("channel");
      history.replaceState(null, "", url);
      load(channel);
    });
  });

  load(selectedChannel());
</script>

<style>
  .get-started {
    width: min(100% - 2.5rem, 760px);
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 7rem) 0 5rem;
    text-align: center;
  }

  .brand-icon {
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    margin: 0 auto 1.75rem;
  }

  .brand-icon img {
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }

  .nightly-icon,
  .get-started[data-channel="nightly"] .stable-icon {
    display: none;
  }

  .get-started[data-channel="nightly"] .nightly-icon {
    display: block;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: var(--fg-dim);
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(2.2rem, 7vw, 4rem);
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .lede {
    max-width: 560px;
    margin: 0 auto 1.75rem;
    color: var(--fg-muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .web-link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 1.4rem;
    border: 1px solid var(--fg);
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .install-card {
    margin-top: 4.5rem;
    padding: clamp(1.25rem, 5vw, 2.25rem);
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
    text-align: left;
  }

  .card-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-heading .eyebrow {
    margin-bottom: 0.35rem;
  }

  h2 {
    margin-bottom: 0;
    font-size: clamp(1.25rem, 4vw, 1.65rem);
    letter-spacing: -0.035em;
  }

  .release-link,
  .source-link {
    color: var(--fg-muted);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .release-link {
    flex: 0 0 auto;
  }

  .release-link:hover,
  .source-link:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  .channel-toggle {
    display: inline-flex;
    gap: 0.25rem;
    margin: 1.5rem 0;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .channel-toggle button {
    min-height: 34px;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }

  .channel-toggle button[aria-selected="true"] {
    background: var(--fg);
    color: var(--bg);
  }

  .commands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .command-group h3 {
    margin-bottom: 0.55rem;
    color: var(--fg-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }

  code {
    display: block;
    overflow-wrap: anywhere;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    font: 0.78rem/1.5 var(--font-mono);
  }

  .nightly-command,
  .get-started[data-channel="nightly"] .stable-command {
    display: none;
  }

  .get-started[data-channel="nightly"] .nightly-command {
    display: block;
  }

  .try-once {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .try-once p {
    grid-column: 1 / -1;
    margin-bottom: 0.25rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  .requirements {
    margin: 1.5rem 0 0.75rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    .card-heading {
      align-items: start;
      flex-direction: column;
    }

    .commands,
    .try-once {
      grid-template-columns: 1fr;
    }

    .try-once p {
      grid-column: auto;
    }
  }
</style>
